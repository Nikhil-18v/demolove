pipeline {

    agent none   

    stages {

        stage('Build on Kubernetes Agent') {

            agent {
                kubernetes {
                    yamlFile 'food-delivery-3-tier-source-code/K8S/pod.yaml'
                }
            }

            stages {


            
                stage('Check Agent') {
                    steps {
                        container('node') {
                            sh '''
                                echo "Running inside Kubernetes Jenkins agent"
                                hostname
                                node --version
                                npm --version
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}
