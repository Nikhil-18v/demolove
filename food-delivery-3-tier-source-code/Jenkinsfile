```groovy
pipeline {

    agent {
        docker {
            image 'nikhilbecomessre/jenkinagentv1:latest'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKER_USER = 'nikhilbecomessre'
        FRONTEND_IMAGE = 'libfrontend'
        BACKEND_IMAGE = 'libbackend'
    }

    stages {

        stage('Check Agent') {
            steps {
                sh '''
                    echo "===== Agent Information ====="

                    echo "Hostname:"
                    hostname

                    echo "OS:"
                    cat /etc/os-release | head

                    echo "Java:"
                    java -version

                    echo "Maven:"
                    mvn -version

                    echo "Node:"
                    node --version

                    echo "NPM:"
                    npm --version

                    echo "Docker:"
                    docker --version

                    echo "User:"
                    whoami
                '''
            }
        }


        stage('Backend Build') {
            steps {
                dir('java-library-3-tier/backend') {

                    sh '''
                        echo "===== Building Java Backend ====="

                        mvn clean test package

                        echo "Backend build completed successfully"

                        echo "Generated artifact:"
                        ls -lh target/
                    '''
                }
            }
        }


        stage('Frontend Build') {
            steps {
                dir('java-library-3-tier/frontend') {

                    sh '''
                        echo "===== Building React Frontend ====="

                        npm install

                        npm run build

                        echo "Frontend build completed successfully"

                        echo "Generated dist directory:"
                        ls -lh dist/
                    '''
                }
            }
        }


        stage('Check Workspace') {
            steps {

                sh '''
                    echo "===== Jenkins Workspace ====="

                    pwd

                    echo "Files:"
                    ls -la

                    echo "Dockerfiles:"
                    find . -name "*.Dockerfile" -print
                '''
            }
        }


        stage('Build Docker Images') {
            steps {

                sh '''
                    echo "===== Building Frontend Docker Image ====="

                    docker build \
                        -t ${DOCKER_USER}/${FRONTEND_IMAGE}:${BUILD_NUMBER} \
                        -f java-library-3-tier/docker/frontend.Dockerfile \
                        java-library-3-tier


                    echo "===== Building Backend Docker Image ====="

                    docker build \
                        -t ${DOCKER_USER}/${BACKEND_IMAGE}:${BUILD_NUMBER} \
                        -f java-library-3-tier/docker/backend.Dockerfile \
                        java-library-3-tier
                '''
            }
        }


        stage('Docker Images') {
            steps {

                sh '''
                    echo "===== Docker Images Created ====="

                    docker images | grep "${DOCKER_USER}"
                '''
            }
        }


        stage('Push Docker Images') {
            steps {

                script {

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'Docker-cred'
                    ) {

                        docker.image(
                            "${DOCKER_USER}/${FRONTEND_IMAGE}:${BUILD_NUMBER}"
                        ).push()


                        docker.image(
                            "${DOCKER_USER}/${BACKEND_IMAGE}:${BUILD_NUMBER}"
                        ).push()
                    }
                }
            }
        }
    }


    post {

        success {
            echo 'Java Library CI Pipeline completed successfully!'
        }

        failure {
            echo 'Java Library CI Pipeline failed!'
        }

    }
}
```
