pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

stage('Backend Build') {
    steps {
        dir('food-delivery-3-tier-source-code/backend') {
            sh '''
                npm install
                echo "Backend dependencies installed successful"
            '''
        }
    }
}

stage('Frontend Build') {
    steps {
        dir('food-delivery-3-tier-source-code/frontend') {
            sh '''
                npm install
                npm run build
                    '''
                }
            }
        }
stage('Check Workspace') {
    steps {
        sh '''
            pwd
            ls -la
            find . -name Dockerfile -print
        '''
    }
}
       stage('Build Docker Images') {
    steps {
        sh '''
            docker build -t YOUR_USERNAME/food-delivery-backend:${BUILD_NUMBER} ./food-delivery-3-tier-source-code/backend
            docker build -t YOUR_USERNAME/food-delivery-frontend:${BUILD_NUMBER} ./food-delivery-3-tier-source-code/frontend
        '''
    }
}

stage('Docker Images') {
    steps {
        sh '''
            docker images | grep food-delivery
        '''
    }
}

stage('Push Docker Images') {
    steps {
        script {
            docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {

                docker.image("YOUR_USERNAME/food-delivery-backend:${BUILD_NUMBER}").push()

                docker.image("YOUR_USERNAME/food-delivery-frontend:${BUILD_NUMBER}").push()
            }
        }
    }
}

    post {
        success {
            echo 'Food Delivery CI Pipeline completed successfully!'
        }

        failure {
            echo 'Food Delivery CI Pipeline failed!'
        }
    }
}
