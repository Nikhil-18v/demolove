pipeline {
  agent {
    docker {
      image 'nikhilbecomessre/jenkinagentv1:latest'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }
  stages {
    stage('Check Agent') {
            steps {
                sh '''
                    echo "Hostname:"
                    hostname

                    echo "OS:"
                    cat /etc/os-release | head

                    echo "Node:"
                    node --version

                    echo "User:"
                    whoami
                '''
            }
        }
        stage('Backend Build') {
            steps {
                dir('food-delivery-3-tier-source-code/backend') {
                    sh '''
                        npm install
                        echo "Backend dependencies installed successful"
                    '''
                }
            }
        }

        stage('Frontend Build') {
            steps {
                dir('food-delivery-3-tier-source-code/frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
        }

        stage('Check Workspace') {
            steps {
                sh '''
                    pwd
                    ls -la
                    find . -name Dockerfile -print
                '''
            }
        }
stage('Docker Login Test') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'Docker-cred',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USER" --password-stdin
                    '''
                }
            }
        }
        stage('Build Frontend Docker Image') {
    steps {
        sh '''
            docker build \
              -t $DOCKER_USER/library-frontend:${BUILD_NUMBER} \
              -f java-library-3-tier/docker/frontend.Dockerfile \
              java-library-3-tier/frontend
        '''
    }
}
    stage('Build Backend Docker Image') {
    steps {
        sh '''
            docker build \
              -t $DOCKER_USER/library-backend:${BUILD_NUMBER} \
              -f java-library-3-tier/docker/backend.Dockerfile \
              java-library-3-tier/backend
        '''
    }
}

        stage('Docker Images') {
            steps {
                sh '''
                    docker images | grep food-delivery
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'Docker-cred') {

                        docker.image("nikhilbecomessre/food-delivery-backend:${BUILD_NUMBER}").push()

                        docker.image("nikhilbecomessre/food-delivery-frontend:${BUILD_NUMBER}").push()
                    }
                }
            }
        }

    }   // <-- closes stages

    post {
        success {
            echo 'Food Delivery CI Pipeline completed successfully!'
        }

        failure {
            echo 'Food Delivery CI Pipeline failed!'
        }
    }
}
