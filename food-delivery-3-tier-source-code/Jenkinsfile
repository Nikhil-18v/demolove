pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Build') {
            steps {
                dir('food-delivery-3-tier-source-code/backend') {
                    sh '''
                        echo "Installing backend dependencies..."
                        npm install
                        echo "Backend dependencies installed successfully"
                    '''
                }
            }
        }
        stage('Frontend Build') {
            steps {
                dir('food-delivery-3-tier-source-code/frontend') {
                    sh '''
                        echo "Installing frontend dependencies..."
                        npm install

                        echo "Building frontend..."
                        npm run build

                        echo "Frontend build completed successfully"
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "Building backend Docker image..."

                    docker build \
                        -t nikhilbecomessre/food-delivery-backend:${BUILD_NUMBER} \
                        -f food-delivery-3-tier-source-code/docker/backend.Dockerfile \
                        food-delivery-3-tier-source-code

                    echo "Building frontend Docker image..."

                    docker build \
                        -t nikhilbecomessre/food-delivery-frontend:${BUILD_NUMBER} \
                        -f food-delivery-3-tier-source-code/docker/frontend.Dockerfile \
                        food-delivery-3-tier-source-code

                    echo "Docker images built successfully"
                '''
            }
        }

        stage('Docker Images') {
            steps {
                sh '''
                    echo "Checking Docker images..."

                    docker images | grep food-delivery
                '''
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'Docker-cred',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Images') {
            steps {
                sh '''
                    echo "Pushing backend image..."

                    docker push \
                        nikhilbecomessre/food-delivery-backend:${BUILD_NUMBER}

                    echo "Backend image pushed successfully"

                    echo "Pushing frontend image..."

                    docker push \
                        nikhilbecomessre/food-delivery-frontend:${BUILD_NUMBER}

                    echo "Frontend image pushed successfully"
                '''
            }
        }

    }

    post {

        success {
            echo '========================================='
            echo 'Food Delivery CI Pipeline SUCCESSFUL!'
            echo "Build Number: ${BUILD_NUMBER}"
            echo 'Docker images pushed successfully!'
            echo '========================================='
        }

        failure {
            echo '========================================='
            echo 'Food Delivery CI Pipeline FAILED!'
            echo "Build Number: ${BUILD_NUMBER}"
            echo 'Check the Jenkins console output.'
            echo '========================================='
        }

        always {
            echo "Pipeline completed for Build #${BUILD_NUMBER}"
        }
    }
}
